# Ключ Hyperbeam API (https://hyperbeam.com → Dashboard → API keys).
# Без ключа сервис стартует в демо-режиме: интерфейс, чат и голос работают,
# а вместо облачного браузера показывается заглушка.
HYPERBEAM_API_KEY=

# Порт локального сервера на ноутбуке.
PORT=8787

# Публичный адрес, по которому к тебе будут подключаться.
#   auto       — Cloudflare Quick Tunnel (brew install cloudflared): без аккаунта,
#                но адрес https://*.trycloudflare.com новый при каждом запуске;
#   tailscale  — Tailscale Funnel: постоянный адрес https://<машина>.<tailnet>.ts.net
#                (настройка — в README, раздел «Постоянная ссылка»);
#   off        — без туннеля (только локальная сеть / localhost);
#   https://watch.example.com — свой адрес (named tunnel и т.п.), сервер просто его показывает.
PUBLIC_URL=auto

# Пускать по публичной ссылке только эти email (через запятую, можно *@домен).
# Cloudflare покажет свою страницу и пришлёт одноразовый код на почту. Пусто — пускает всех со ссылкой.
# Работает только с PUBLIC_URL=auto.
TUNNEL_ALLOWED_EMAILS=

# Пароль, которым любой со ссылкой может закрыть открытую комнату
# (если ведущий вылетел и комната повисла). Ведущему пароль не нужен.
ROOM_PASSWORD=12345

# Комната без участников закрывается сама через столько секунд.
EMPTY_ROOM_TIMEOUT=600

# Регион облачного браузера по умолчанию: NA | EU | AS (EU ближе всего к Казахстану/РФ).
HYPERBEAM_REGION=EU

# Страховочные таймауты облачной сессии (секунды).
# OFFLINE — сессия сама закроется, если в ней никого нет столько времени.
# ABSOLUTE — жёсткий предел длительности (на случай, если ноутбук «умер» и не смог закрыть сессию).
HB_OFFLINE_TIMEOUT=600
HB_ABSOLUTE_TIMEOUT=21600

# TURN-сервер для голосового канала (необязательно). Без него голос идёт P2P через STUN,
# что работает в большинстве домашних и мобильных сетей. Можно перечислить через запятую.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
